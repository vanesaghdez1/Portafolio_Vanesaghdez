---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { ui } from '../i18n/ui';
---

<Layout title={`404 — ${ui.es['404.title']}`} noindex>
  <main class="relative isolate grid min-h-dvh place-items-center px-5 text-center">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-60"></div>
    <div>
      <p class="text-gradient font-mono text-7xl font-bold md:text-8xl">404</p>
      <h1 class="mt-4 text-2xl font-bold">
        {ui.es['404.title']} <span class="text-muted">/ {ui.en['404.title']}</span>
      </h1>
      <p class="mt-3 text-muted">{ui.es['404.text']}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-text px-5 py-3 text-sm font-semibold text-bg transition hover:opacity-90">
          <Icon name="arrowRight" size={16} class="rotate-180" />
          {ui.es['404.back']}
        </a>
        <a href="/en/" class="inline-flex items-center gap-2 rounded-lg border border-border px-5 py-3 text-sm font-semibold transition hover:border-accent">
          {ui.en['404.back']}
        </a>
      </div>
    </div>
  </main>
</Layout>
