---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { getLang, l, useTranslations } from '../i18n/utils';
import { skillGroups } from '../data/skills';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section id="skills" class="py-16 md:py-24">
  <div class="container-page">
    <SectionHeading kicker={t('skills.kicker')} title={t('skills.title')} subtitle={t('skills.subtitle')} />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        skillGroups.map((group, i) => (
          <article
            class="reveal group rounded-2xl border border-border bg-surface p-6 transition-colors hover:border-accent/60"
            style={`transition-delay: ${i * 70}ms`}
          >
            <div class="mb-5 flex items-center gap-3">
              <span class="grid size-10 place-items-center rounded-lg bg-surface-2 text-accent transition-colors group-hover:text-accent-2">
                <Icon name={group.icon} size={20} />
              </span>
              <h3 class="font-semibold">{l(group.title, lang)}</h3>
            </div>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-md border border-border bg-bg px-2.5 py-1 font-mono text-xs text-muted">{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
