---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { getLang, l, useTranslations } from '../i18n/utils';
import { experience, homeBullets } from '../data/resume';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section id="experience" class="py-16 md:py-24">
  <div class="container-page">
    <SectionHeading
      kicker={t('experience.kicker')}
      title={t('experience.title')}
      subtitle={t('experience.subtitle')}
    />

    <ol class="relative space-y-6 border-l border-border pl-6 md:pl-10">
      {
        experience.map((job) => (
          <li class="reveal relative">
            <span
              class:list={[
                'absolute top-7 -left-[31px] grid size-3 place-items-center rounded-full ring-4 ring-bg md:-left-[47px]',
                job.current ? 'bg-accent' : 'bg-border',
              ]}
            />
            <article class="rounded-2xl border border-border bg-surface p-6 transition-colors hover:border-accent/60 md:p-7">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                <div>
                  <h3 class="text-lg font-semibold tracking-tight">{l(job.role, lang)}</h3>
                  <p class="mt-0.5 flex flex-wrap items-center gap-x-2 text-muted">
                    <span class="font-medium text-accent">{job.company}</span>
                    {job.location && <span class="text-sm">· {l(job.location, lang)}</span>}
                  </p>
                </div>
                <p class="flex shrink-0 items-center gap-2 font-mono text-xs text-muted sm:pt-1.5">
                  {job.current && (
                    <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 font-sans font-medium text-emerald-600 dark:text-emerald-400">
                      {t('experience.current')}
                    </span>
                  )}
                  {l(job.period, lang)}
                </p>
              </div>

              <ul class="mt-4 space-y-2 text-muted">
                {job.bullets.slice(0, homeBullets).map((b) => (
                  <li class="flex gap-3 leading-relaxed">
                    <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent/70" />
                    <span>{l(b, lang)}</span>
                  </li>
                ))}
              </ul>

              <ul class="mt-5 flex flex-wrap gap-2">
                {job.tech.map((tech) => (
                  <li class="rounded-md bg-surface-2 px-2.5 py-1 font-mono text-xs text-muted">{tech}</li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ol>

    <a
      href={getRelativeLocaleUrl(lang, 'cv')}
      class="reveal group mt-8 inline-flex items-center gap-2 text-sm font-medium text-accent"
    >
      <Icon name="fileText" size={16} />
      {t('experience.more')}
      <Icon name="arrowRight" size={14} class="transition-transform group-hover:translate-x-0.5" />
    </a>
  </div>
</section>
