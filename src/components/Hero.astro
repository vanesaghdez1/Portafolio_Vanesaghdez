---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon, { type IconName } from './Icon.astro';
import { getLang, l, useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';
import { certifications, education, experience, languagesSpoken } from '../data/resume';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const currentJob = experience.find((e) => e.current) ?? experience[0];
const degree = education[0];
const inProgress = certifications.find((c) => c.status);

// Panel de datos clave (columna derecha)
const facts: { icon: IconName; label: string; value: string; detail?: string }[] = [
  ...(currentJob
    ? [{ icon: 'briefcase' as const, label: t('hero.panel.current'), value: l(currentJob.role, lang), detail: currentJob.company }]
    : []),
  ...(degree
    ? [{ icon: 'graduation' as const, label: t('hero.panel.education'), value: l(degree.degree, lang), detail: 'IPN — ESIME Culhuacán' }]
    : []),
  { icon: 'code', label: t('hero.panel.stack'), value: profile.heroStack.join(' · ') },
  {
    icon: 'languages',
    label: t('hero.panel.languages'),
    value: languagesSpoken.map((x) => `${l(x.name, lang)} (${l(x.level, lang).split(' ')[0]})`).join(' · '),
  },
  ...(inProgress
    ? [{ icon: 'award' as const, label: l(inProgress.status!, lang), value: l(inProgress.name, lang) }]
    : []),
];
---

<section class="relative isolate overflow-hidden border-b border-border pt-32 pb-16 md:pt-40 md:pb-24">
  <!-- Fondo: banda azul muy suave -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: linear-gradient(180deg, var(--accent-soft) 0%, transparent 85%);"
  >
  </div>

  <div class="container-page grid items-center gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
    <div>
      {
        profile.available && (
          <p class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-muted">
            <span class="size-2 rounded-full bg-emerald-500" />
            {t('hero.available')}
          </p>
        )
      }

      <h1 class="reveal text-4xl font-bold tracking-tight text-balance sm:text-5xl md:text-[3.5rem] md:leading-[1.1]">
        {profile.shortName}
      </h1>
      <p class="reveal mt-3 text-xl font-semibold text-accent sm:text-2xl">{l(profile.role, lang)}</p>

      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-pretty text-muted">
        {l(profile.tagline, lang)}
      </p>

      <div class="reveal mt-9 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="group inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90 dark:text-bg"
        >
          {t('hero.cta.projects')}
          <Icon name="arrowRight" size={16} class="transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href={getRelativeLocaleUrl(lang, 'cv')}
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-5 py-3 text-sm font-semibold transition hover:border-accent"
        >
          <Icon name="fileText" size={16} />
          {t('hero.cta.cv')}
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-lg px-4 py-3 text-sm font-semibold text-muted transition hover:text-text"
        >
          {t('hero.cta.contact')}
        </a>
      </div>

      <div class="reveal mt-10 flex flex-wrap items-center gap-5 text-muted">
        {
          profile.socials.github && (
            <a href={profile.socials.github} target="_blank" rel="noopener noreferrer" class="transition hover:text-accent" aria-label="GitHub">
              <Icon name="github" size={21} />
            </a>
          )
        }
        {
          profile.socials.linkedin && (
            <a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer" class="transition hover:text-accent" aria-label="LinkedIn">
              <Icon name="linkedin" size={21} />
            </a>
          )
        }
        <a href={`mailto:${profile.email}`} class="transition hover:text-accent" aria-label="Email">
          <Icon name="mail" size={21} />
        </a>
        <span class="h-px w-10 bg-border"></span>
        <span class="inline-flex items-center gap-1.5 text-sm">
          <Icon name="mapPin" size={16} />
          {l(profile.location, lang)}
        </span>
      </div>
    </div>

    <!-- Panel de datos clave -->
    <aside class="reveal overflow-hidden rounded-xl border border-border bg-surface shadow-sm">
      <div class="flex items-center gap-4 border-b border-border bg-accent-soft/60 px-6 py-5">
        <span class="grid size-12 shrink-0 place-items-center rounded-full border border-accent/30 bg-surface font-semibold text-accent">
          {profile.initials}
        </span>
        <div>
          <p class="font-semibold">{profile.name}</p>
          <p class="text-sm text-muted">{l(profile.role, lang)}</p>
        </div>
      </div>
      <dl class="divide-y divide-border">
        {
          facts.map((f) => (
            <div class="flex gap-4 px-6 py-4">
              <Icon name={f.icon} size={18} class="mt-0.5 shrink-0 text-accent" />
              <div class="min-w-0">
                <dt class="text-xs font-medium tracking-wide text-muted uppercase">{f.label}</dt>
                <dd class="mt-0.5 text-sm font-medium">{f.value}</dd>
                {f.detail && <dd class="text-sm text-muted">{f.detail}</dd>}
              </div>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</section>
