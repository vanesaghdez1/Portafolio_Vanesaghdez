---
interface Props {
  kicker: string;
  title: string;
  subtitle?: string;
}
const { kicker, title, subtitle } = Astro.props;
---

<div class="reveal mb-12 md:mb-16">
  <p class="flex items-center gap-3 font-mono text-sm text-accent">
    <span>{kicker}.</span>
    <span class="h-px w-12 bg-accent/40"></span>
  </p>
  <h2 class="mt-3 text-3xl font-bold tracking-tight text-balance md:text-4xl">{title}</h2>
  {subtitle && <p class="mt-3 max-w-2xl text-muted">{subtitle}</p>}
</div>
