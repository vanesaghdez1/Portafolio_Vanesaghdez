---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { getLang, useTranslations } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { profile } from '../data/profile';
import { education, experience } from '../data/resume';
import { skillGroups } from '../data/skills';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { title = t('meta.title'), description = t('meta.description'), noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const ogLocale = lang === 'es' ? 'es_MX' : 'en_US';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role[lang],
  url: Astro.site?.toString(),
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Ciudad de México', addressCountry: 'MX' },
  sameAs: Object.values(profile.socials).filter(Boolean),
  worksFor: experience.find((e) => e.current) && {
    '@type': 'Organization',
    name: experience.find((e) => e.current)?.company,
  },
  alumniOf: education.map((ed) => ({ '@type': 'CollegeOrUniversity', name: ed.school })),
  knowsAbout: skillGroups.flatMap((g) => g.items),
  knowsLanguage: ['es', 'en'],
};
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      Object.keys(languages).map((code) => (
        <link rel="alternate" hreflang={code} href={getAbsoluteLocaleUrl(code, '')} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('es', '')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#08090e" />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Aplica el tema antes de pintar para evitar parpadeo -->
    <script is:inline>
      (() => {
        // Oscuro por defecto; el claro solo si el visitante lo eligió con el botón
        let theme = 'dark';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-h-dvh overflow-x-hidden">
    <slot />

    <script>
      // Aparición suave de secciones al hacer scroll
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
